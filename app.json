{
  "expo": {
    "name": "S.P.A.R.K",
    "slug": "spark-finance",
    "version": "3.3.0",
    "orientation": "portrait",
    "icon": "./assets/spark-icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#050505",
    "scheme": "spark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spark.finance"
    },
    "android": {
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#050505",
        "foregroundImage": "./assets/spark-icon.png"
      },
      "package": "com.spark.finance",
      "versionCode": 13,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/spark-icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050505",
          "image": "./assets/spark-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#050505",
            "image": "./assets/spark-icon.png"
          }
        }
      ],
      "expo-system-ui",
      "expo-font",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "S.P.A.R.K. fiş taramak için kameranıza erişmek istiyor."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "S.P.A.R.K. logo ve fiş yüklemek için galerinize erişmek istiyor."
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      "expo-sharing"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6e22ef61-4027-4f79-811b-cde50765e90e"
      },
      "privacyPolicyUrl": "https://ruslanaeff.github.io/privacy-policy.html"
    },
    "owner": "ruslanaeff0"
  }
}
