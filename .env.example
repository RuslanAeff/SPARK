# S.P.A.R.K. — Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun.
# .env dosyası .gitignore'da olmalıdır.

# EAS Build — isteğe bağlı. Varsayılan proje ID'si app.json > extra.eas.projectId
# içindedir (gizli değildir). Yalnız başka bir EAS projesine derlerken tanımlayın.
# EAS_PROJECT_ID=your-project-id-here
